# Copy to .env (gitignored) and fill in. Never commit .env.
# HINT: generate a token with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Long random path segment that makes the public feed URL unguessable.
# Final URL = <public_base_url>/<NEWNEWS_FEED_TOKEN>/feed.xml
NEWNEWS_FEED_TOKEN=

# Optional. ntfy.sh topic for failure alerts and agent-loop summaries.
# Overrides ntfy_topic in config/sources.yaml. Leave empty to disable.
# HINT: ntfy topics are public-by-name, so pick a long random one.
NTFY_TOPIC=
