{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "external_directory": "deny",
    "bash": {
      "*": "allow",
      "uv add*": "allow",
      "uv sync*": "allow",
      "uv pip install*": "deny",
      "uv tool install*": "deny",
      "pip install*": "deny",
      "pip3 install*": "deny",
      "python* -m pip*": "deny",
      "brew *": "deny",
      "npm *": "deny",
      "npx *": "deny",
      "git push*": "deny",
      "git * push*": "deny",
      "rm -rf*": "deny",
      "sudo *": "deny"
    }
  },
  "agent": {
    "plan": { "permission": { "edit": "deny" } }
  }
}
